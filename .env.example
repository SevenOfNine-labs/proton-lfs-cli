# Proton LFS environment configuration (copied to .env by `make setup`).
# Nothing loads .env automatically; export the values in the shell that runs
# git or the tray. Variables of the first section are read by
# git-lfs-proton-adapter (docs/reference/adapter.md); those of the second by
# proton-drive-cli. No variable carries a credential.
# This project is pre-production. Do not use it for production data.

# --- git-lfs-proton-adapter ---------------------------------------------
# Backend: local (filesystem object store) or sdk (Proton Drive).
PROTON_LFS_BACKEND=local
# Object root of the local backend (required when PROTON_LFS_BACKEND=local).
PROTON_LFS_LOCAL_STORE_DIR=
# Simulate transfers without a backend (protocol tests only).
ADAPTER_ALLOW_MOCK_TRANSFERS=false
# proton-drive-cli entry point: a .js file run with node, or the standalone
# executable. Default: submodules/proton-drive-cli/dist/index.js
PROTON_DRIVE_CLI_BIN=
# Node.js binary used for a .js entry point (default: node on PATH).
NODE_BIN=
# Base timeout for one bridge command (Go duration, default 5m); uploads and
# downloads add one second per 256 KiB.
PROTON_LFS_BRIDGE_TIMEOUT=5m
# Remote base folder in Proton Drive (objects live at /<base>/ab/cd/<oid>).
LFS_STORAGE_BASE=LFS
# Status report written by the adapter and read by the tray
# (default ~/.proton-lfs/status.json).
PROTON_LFS_STATUS_FILE=
# x-pm-appversion sent as the bridge appVersion field (default: proton-drive-cli's
# external-drive-protonlfscli@<version>): external-drive-{name}@{major.minor.patch}
# with an optional -stable, -beta or -alpha channel and +build suffix, {name} in
# lowercase letters/underscores; cli-drive is reserved for official Proton builds.
PROTON_APP_VERSION=

# --- proton-drive-cli ----------------------------------------------------
# pass-cli binary path (default: pass-cli on PATH); the adapter forwards it
# to bridge commands.
PROTON_PASS_CLI_BIN=pass-cli
# Key-password provider for `proton-drive-cli login`: pass-cli (default) or
# git-credential. Read only by login, which records it in the session; the
# adapter does not forward it.
PROTON_KEY_PASSWORD_PROVIDER=pass-cli
# Host/key of the key-password entry for `proton-drive-cli login`
# (default proton-drive-key.proton-lfs-cli.local).
PROTON_KEY_PASSWORD_HOST=
