# Proton LFS environment configuration (copied to .env by `make setup`).
# Every variable below is read by git-lfs-proton-adapter or forwarded by it
# to proton-drive-cli; see docs/reference/adapter.md.
# This project is pre-production. Do not use it for production data.

# --- git-lfs-proton-adapter ---------------------------------------------
# Backend: local (filesystem object store) or sdk (Proton Drive).
PROTON_LFS_BACKEND=local
# Object root of the local backend (required when PROTON_LFS_BACKEND=local).
PROTON_LFS_LOCAL_STORE_DIR=
# Simulate transfers without a backend (protocol tests only).
ADAPTER_ALLOW_MOCK_TRANSFERS=false
# proton-drive-cli entry point: a .js file run with node, or the standalone
# executable. Default: submodules/proton-drive-cli/dist/index.js
PROTON_DRIVE_CLI_BIN=
# Node.js binary used for a .js entry point (default: node on PATH).
NODE_BIN=
# Base timeout for one bridge command (Go duration, default 5m); uploads and
# downloads add one second per 256 KiB.
PROTON_LFS_BRIDGE_TIMEOUT=5m
# Remote base folder in Proton Drive (objects live at /<base>/ab/cd/<oid>).
LFS_STORAGE_BASE=LFS
# Where the adapter writes its status report (default ~/.proton-lfs/status.json).
PROTON_LFS_STATUS_FILE=
# Optional override of the Proton x-pm-appversion identity forwarded to
# proton-drive-cli. Leave empty to use its built-in default
# (external-drive-protonlfscli@<version>). Overrides must follow Proton's
# third-party grammar: external-drive-{name}@{major.minor.patch}[-stable|beta|alpha][+build]
# with {name} in lowercase letters/underscores. Never use cli-drive (official builds only).
PROTON_APP_VERSION=

# --- two-password accounts (mailbox/data password) ------------------------
# Provider holding the mailbox/data password: pass-cli or git-credential.
# Leave empty for browser-fork sessions with a stored key password.
PROTON_DATA_CREDENTIAL_PROVIDER=
# Host/key of that entry (default proton-data.proton-lfs-cli.local).
PROTON_DATA_CREDENTIAL_HOST=

# --- forwarded to proton-drive-cli --------------------------------------
# Key-password provider used by `proton-drive-cli login` and `doctor`:
# pass-cli (default) or git-credential.
PROTON_KEY_PASSWORD_PROVIDER=pass-cli
# Host/key of the key-password entry (default proton-drive-key.proton-lfs-cli.local).
PROTON_KEY_PASSWORD_HOST=
# pass-cli binary path used by proton-drive-cli (default: pass-cli on PATH).
PROTON_PASS_CLI_BIN=pass-cli
